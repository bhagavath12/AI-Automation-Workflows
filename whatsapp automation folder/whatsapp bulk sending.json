    {
      "parameters": {
        "jsCode": "// Normalize phone number to E.164 format\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let phone = String(item.json.Phone_Number || '').trim();\n  let name = String(item.json.Name || '').trim();\n\n  // Remove spaces, dashes, dots, parentheses\n  phone = phone.replace(/[\\s\\-\\.\\(\\)]/g, '');\n\n  // Remove leading + if present (we'll add it back)\n  phone = phone.replace(/^\\+/, '');\n\n  // Remove leading 0 (local format like 09666381867)\n  phone = phone.replace(/^0/, '');\n\n  // If it starts with 91 and has 12 digits total, it already has country code\n  // If it's 10 digits, prepend 91\n  if (phone.length === 10) {\n    phone = '91' + phone;\n  } else if (phone.length === 12 && phone.startsWith('91')) {\n    // Already correct\n  } else if (phone.length === 11 && phone.startsWith('0')) {\n    // Edge case: 0-prefixed after earlier strip didn't catch it\n    phone = '91' + phone.slice(1);\n  }\n\n  // Final E.164 format\n  phone = '+' + phone;\n\n  results.push({\n    json: {\n      ...item.json,\n      Name: name,\n      Phone_Number: phone\n    }\n  });\n}\n\nreturn results;"
      },
